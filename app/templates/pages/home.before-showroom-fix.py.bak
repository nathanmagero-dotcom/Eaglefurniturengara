{% extends "base.html" %}

{% block title %}
Eagle Furniture Ngara | Furniture Shop in Nairobi | Sofas, Beds, Dining & Custom Furniture
{% endblock %}

{% block meta_description %}
Eagle Furniture Ngara is a trusted furniture shop in Nairobi offering bespoke sofas, beds, dining sets, TV units, wardrobes, office furniture and custom-made furniture. Visit us on Murang'a Road next to Kahama Hotel or order by WhatsApp.
{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="{{ url_for('static', filename='css/pages/home.css') }}">

<style>
    /* =========================================================
       HOMEPAGE FALLBACK LAYOUT
       These styles keep the page clean even before home.css
       is fully refined.
    ========================================================= */

    .ef-home {
        background: #fff;
        color: #241814;
    }

    .ef-container {
        width: min(1280px, calc(100% - 40px));
        margin: 0 auto;
    }

    .ef-section {
        padding: 80px 0;
    }

    .ef-section-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 30px;
        margin-bottom: 35px;
    }

    .ef-eyebrow {
        display: block;
        margin-bottom: 10px;
        font-size: .75rem;
        font-weight: 800;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: #a67c32;
    }

    .ef-section-head h2 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.05;
        color: #2e211c;
    }

    .ef-section-head p {
        max-width: 570px;
        margin: 12px 0 0;
        color: #766b66;
        line-height: 1.7;
    }

    .ef-link {
        color: #5b3a2c;
        font-weight: 700;
        text-decoration: none;
        white-space: nowrap;
    }

    .ef-link:hover {
        color: #a67c32;
    }

    /* =========================================================
       HERO
    ========================================================= */

    .ef-hero {
        position: relative;
        min-height: 650px;
        display: flex;
        align-items: center;
        overflow: hidden;
        background:
            linear-gradient(90deg, rgba(24, 15, 11, .88), rgba(24, 15, 11, .52), rgba(24, 15, 11, .15)),
            url("{{ url_for('static', filename='images/hero.jpg') }}") center/cover no-repeat;
    }

    .ef-hero-content {
        position: relative;
        z-index: 2;
        width: min(760px, 100%);
        padding: 90px 0;
        color: #fff;
    }

    .ef-hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
        font-size: .78rem;
        font-weight: 800;
        letter-spacing: .17em;
        text-transform: uppercase;
        color: #e4bd72;
    }

    .ef-hero-kicker::before {
        content: "";
        width: 34px;
        height: 2px;
        background: #e4bd72;
    }

    .ef-hero h1 {
        margin: 0;
        max-width: 780px;
        font-size: clamp(3rem, 6vw, 5.8rem);
        line-height: .98;
        letter-spacing: -.04em;
    }

    .ef-hero h1 span {
        display: block;
        color: #e4bd72;
    }

    .ef-hero p {
        max-width: 650px;
        margin: 25px 0 0;
        color: rgba(255,255,255,.88);
        font-size: 1.08rem;
        line-height: 1.8;
    }

    .ef-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 32px;
    }

    .ef-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        min-height: 52px;
        padding: 0 25px;
        border-radius: 4px;
        font-weight: 800;
        text-decoration: none;
        transition: .2s ease;
    }

    .ef-btn-primary {
        background: #a67c32;
        color: #fff;
    }

    .ef-btn-primary:hover {
        background: #8e6727;
        color: #fff;
        transform: translateY(-2px);
    }

    .ef-btn-light {
        border: 1px solid rgba(255,255,255,.55);
        color: #fff;
    }

    .ef-btn-light:hover {
        background: #fff;
        color: #2e211c;
    }

    .ef-hero-trust {
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        margin-top: 40px;
        color: rgba(255,255,255,.82);
        font-size: .9rem;
    }

    .ef-hero-trust span {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .ef-hero-trust i {
        color: #e4bd72;
    }

    /* =========================================================
       QUICK NAVIGATION
    ========================================================= */

    .ef-quick-nav {
        position: relative;
        z-index: 4;
        margin-top: -55px;
    }

    .ef-quick-inner {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        background: #fff;
        box-shadow: 0 15px 45px rgba(40, 25, 15, .13);
    }

    .ef-quick-item {
        display: flex;
        align-items: center;
        gap: 15px;
        min-height: 105px;
        padding: 20px 25px;
        color: #30221d;
        text-decoration: none;
        border-right: 1px solid #eee7e2;
        transition: .2s ease;
    }

    .ef-quick-item:last-child {
        border-right: 0;
    }

    .ef-quick-item:hover {
        background: #faf7f3;
    }

    .ef-quick-icon {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        background: #f2e9dc;
        color: #8b652a;
        font-size: 1.15rem;
    }

    .ef-quick-item strong {
        display: block;
        font-size: .96rem;
    }

    .ef-quick-item small {
        display: block;
        margin-top: 4px;
        color: #81756f;
    }

    /* =========================================================
       DEPARTMENT / SHOWROOM
    ========================================================= */

    .ef-showroom {
        background: #faf8f5;
    }

    .ef-department {
        padding: 45px 0;
        border-bottom: 1px solid #e8e0d9;
    }

    .ef-department:first-child {
        padding-top: 10px;
    }

    .ef-department-head {
        display: flex;
        justify-content: space-between;
        align-items: end;
        gap: 20px;
        margin-bottom: 25px;
    }

    .ef-department-head h3 {
        margin: 0;
        font-size: 1.75rem;
        color: #2f211b;
    }

    .ef-department-head p {
        margin: 7px 0 0;
        color: #7b706a;
    }

    /* =========================================================
       SUBCATEGORY CARDS
    ========================================================= */

    .ef-subcategories {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 30px;
    }

    .ef-subcategory {
        position: relative;
        min-height: 150px;
        overflow: hidden;
        border-radius: 6px;
        background: #ddd;
        color: #fff;
        text-decoration: none;
    }

    .ef-subcategory::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(0deg, rgba(20,13,9,.78), rgba(20,13,9,.05));
    }

    .ef-subcategory img {
        width: 100%;
        height: 100%;
        min-height: 150px;
        object-fit: cover;
        transition: transform .35s ease;
    }

    .ef-subcategory:hover img {
        transform: scale(1.06);
    }

    .ef-subcategory-content {
        position: absolute;
        z-index: 2;
        left: 16px;
        right: 16px;
        bottom: 15px;
    }

    .ef-subcategory-content strong {
        display: block;
        font-size: 1rem;
    }

    .ef-subcategory-content small {
        display: block;
        margin-top: 3px;
        color: rgba(255,255,255,.78);
    }

    /* =========================================================
       PRODUCT CARDS
    ========================================================= */

    .ef-products {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    .ef-product {
        min-width: 0;
        background: #fff;
        border: 1px solid #eee7e2;
        border-radius: 5px;
        overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease;
    }

    .ef-product:hover {
        transform: translateY(-4px);
        box-shadow: 0 15px 35px rgba(42, 26, 18, .10);
    }

    .ef-product-media {
        position: relative;
        display: block;
        aspect-ratio: 1 / .86;
        overflow: hidden;
        background: #f4f1ee;
    }

    .ef-product-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform .35s ease;
    }

    .ef-product:hover .ef-product-media img {
        transform: scale(1.04);
    }

    .ef-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 2;
        padding: 6px 9px;
        border-radius: 3px;
        background: #a67c32;
        color: #fff;
        font-size: .68rem;
        font-weight: 800;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .ef-product-body {
        padding: 18px;
    }

    .ef-product-category {
        display: block;
        margin-bottom: 7px;
        color: #9a7240;
        font-size: .7rem;
        font-weight: 800;
        letter-spacing: .09em;
        text-transform: uppercase;
    }

    .ef-product-name {
        margin: 0;
        min-height: 44px;
        font-size: 1rem;
        line-height: 1.4;
    }

    .ef-product-name a {
        color: #2d211c;
        text-decoration: none;
    }

    .ef-product-name a:hover {
        color: #9a702e;
    }

    .ef-product-price {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 12px;
    }

    .ef-price-current {
        color: #2d211c;
        font-size: 1.05rem;
        font-weight: 900;
    }

    .ef-price-old {
        color: #99908a;
        font-size: .82rem;
        text-decoration: line-through;
    }

    .ef-product-description {
        margin: 10px 0 0;
        color: #766b65;
        font-size: .84rem;
        line-height: 1.55;
    }

    .ef-product-action {
        display: flex;
        gap: 8px;
        margin-top: 16px;
    }

    .ef-product-action a {
        flex: 1;
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border-radius: 3px;
        text-decoration: none;
        font-size: .78rem;
        font-weight: 800;
    }

    .ef-view-product {
        background: #3e2723;
        color: #fff;
    }

    .ef-view-product:hover {
        background: #2d1b18;
        color: #fff;
    }

    .ef-whatsapp {
        border: 1px solid #d9d0ca;
        color: #3e2723;
    }

    .ef-whatsapp:hover {
        border-color: #3e2723;
    }

    .ef-collection-footer {
        margin-top: 25px;
        text-align: center;
    }

    .ef-collection-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border: 1px solid #d8cec5;
        color: #3e2723;
        text-decoration: none;
        font-weight: 800;
        border-radius: 3px;
    }

    .ef-collection-button:hover {
        background: #3e2723;
        color: #fff;
    }

    /* =========================================================
       OFFERS / FEATURED / BEST SELLERS
    ========================================================= */

    .ef-offers {
        background: #2e211c;
        color: #fff;
    }

    .ef-offers .ef-section-head h2 {
        color: #fff;
    }

    .ef-offers .ef-section-head p {
        color: rgba(255,255,255,.7);
    }

    .ef-offers .ef-product {
        border: 0;
    }

    .ef-offer-badge {
        background: #b58a3a;
    }

    /* =========================================================
       BRAND / CUSTOM FURNITURE
    ========================================================= */

    .ef-custom {
        background: #f5efe8;
    }

    .ef-custom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        min-height: 430px;
        overflow: hidden;
        background: #fff;
    }

    .ef-custom-image {
        min-height: 430px;
        background:
            linear-gradient(rgba(30,18,12,.15), rgba(30,18,12,.15)),
            url("{{ url_for('static', filename='images/categories/sofas.jpg') }}")
            center/cover no-repeat;
    }

    .ef-custom-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 55px;
    }

    .ef-custom-content h2 {
        margin: 0;
        font-size: clamp(2rem, 4vw, 3.2rem);
        line-height: 1.05;
        color: #30211b;
    }

    .ef-custom-content p {
        margin: 20px 0 0;
        color: #746963;
        line-height: 1.8;
    }

    .ef-benefits {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin: 28px 0;
    }

    .ef-benefit {
        display: flex;
        gap: 10px;
        color: #4d3a31;
        font-size: .88rem;
        font-weight: 700;
    }

    .ef-benefit i {
        color: #a67c32;
    }

    /* =========================================================
       PACKAGES
    ========================================================= */

    .ef-packages {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .ef-package {
        padding: 28px;
        border: 1px solid #e7dfd8;
        background: #fff;
    }

    .ef-package h3 {
        margin: 0;
        color: #30221d;
    }

    .ef-package p {
        color: #756a64;
        line-height: 1.6;
    }

    .ef-package a {
        display: inline-flex;
        margin-top: 10px;
        color: #8d672d;
        font-weight: 800;
        text-decoration: none;
    }

    /* =========================================================
       FINAL CTA
    ========================================================= */

    .ef-final-cta {
        padding: 85px 0;
        background: #3e2723;
        color: #fff;
        text-align: center;
    }

    .ef-final-cta h2 {
        margin: 0;
        font-size: clamp(2.1rem, 4vw, 3.7rem);
    }

    .ef-final-cta p {
        max-width: 650px;
        margin: 17px auto 0;
        color: rgba(255,255,255,.75);
        line-height: 1.7;
    }

    .ef-final-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    /* =========================================================
       EMPTY STATES
    ========================================================= */

    .ef-empty {
        padding: 35px;
        border: 1px dashed #d9d0ca;
        color: #81756f;
        text-align: center;
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @media (max-width: 1100px) {
        .ef-subcategories {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .ef-products {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @media (max-width: 850px) {
        .ef-hero {
            min-height: 590px;
        }

        .ef-quick-inner {
            grid-template-columns: repeat(2, 1fr);
        }

        .ef-quick-item:nth-child(2) {
            border-right: 0;
        }

        .ef-quick-item:nth-child(-n+2) {
            border-bottom: 1px solid #eee7e2;
        }

        .ef-subcategories {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .ef-products {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ef-custom-grid {
            grid-template-columns: 1fr;
        }

        .ef-custom-image {
            min-height: 300px;
        }

        .ef-packages {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 600px) {
        .ef-container {
            width: min(100% - 28px, 1280px);
        }

        .ef-section {
            padding: 58px 0;
        }

        .ef-hero {
            min-height: 620px;
        }

        .ef-hero-content {
            padding: 70px 0;
        }

        .ef-hero h1 {
            font-size: 3rem;
        }

        .ef-hero p {
            font-size: .96rem;
        }

        .ef-hero-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .ef-btn {
            width: 100%;
        }

        .ef-hero-trust {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .ef-quick-nav {
            margin-top: 0;
        }

        .ef-quick-inner {
            grid-template-columns: 1fr 1fr;
        }

        .ef-quick-item {
            padding: 18px 13px;
            min-height: 90px;
        }

        .ef-quick-icon {
            width: 38px;
            height: 38px;
            flex-basis: 38px;
        }

        .ef-section-head,
        .ef-department-head {
            display: block;
        }

        .ef-section-head .ef-link,
        .ef-department-head .ef-link {
            display: inline-flex;
            margin-top: 15px;
        }

        .ef-subcategories {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ef-products {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .ef-product-body {
            padding: 12px;
        }

        .ef-product-name {
            min-height: 42px;
            font-size: .88rem;
        }

        .ef-product-description {
            display: none;
        }

        .ef-product-action {
            flex-direction: column;
        }

        .ef-custom-content {
            padding: 35px 25px;
        }

        .ef-benefits {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 390px) {
        .ef-products {
            grid-template-columns: 1fr;
        }

        .ef-subcategories {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>
{% endblock %}


{% block content %}

<div class="ef-home">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="ef-hero">

        <div class="ef-container">

            <div class="ef-hero-content">

                <span class="ef-hero-kicker">
                    Eagle Furniture Ngara · Nairobi
                </span>

                <h1>
                    Furniture Made
                    <span>For Your Space.</span>
                </h1>

                <p>
                    Discover bespoke, timeless and good-quality furniture
                    made to order for homes, offices, restaurants and
                    commercial spaces. Choose your design, colour, size
                    and finish.
                </p>

                <div class="ef-hero-actions">

                    {% if categories %}
                        {% set first_category = categories[0] %}

                        {% if first_category.home_subcategories %}
                            {% set first_subcategory = first_category.home_subcategories[0] %}

                            <a href="{{ url_for('main.collection', slug=first_subcategory.slug) }}"
                               class="ef-btn ef-btn-primary">
                                Explore Furniture
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        {% endif %}
                    {% endif %}

                    <a href="https://wa.me/254717369779"
                       class="ef-btn ef-btn-light"
                       target="_blank"
                       rel="noopener">
                        <i class="bi bi-whatsapp"></i>
                        WhatsApp Us
                    </a>

                </div>

                <div class="ef-hero-trust">

                    <span>
                        <i class="bi bi-check-circle-fill"></i>
                        Made to Order
                    </span>

                    <span>
                        <i class="bi bi-palette-fill"></i>
                        Custom Designs
                    </span>

                    <span>
                        <i class="bi bi-truck"></i>
                        Nairobi Delivery
                    </span>

                    <span>
                        <i class="bi bi-shield-check"></i>
                        Quality Furniture
                    </span>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         QUICK NAVIGATION
    ====================================================== -->

    <section class="ef-quick-nav">

        <div class="ef-container">

            <div class="ef-quick-inner">

                {% set quick_items = [] %}

                {% for category in categories %}

                    {% if category.home_subcategories and quick_items|length < 4 %}

                        {% set subcategory = category.home_subcategories[0] %}

                        <a href="{{ url_for('main.collection', slug=subcategory.slug) }}"
                           class="ef-quick-item">

                            <span class="ef-quick-icon">

                                {% if category.name|lower in ['sofas', 'living room'] %}
                                    <i class="bi bi-house-heart"></i>

                                {% elif category.name|lower in ['beds', 'bedroom'] %}
                                    <i class="bi bi-moon-stars"></i>

                                {% elif category.name|lower in ['dining sets', 'dining'] %}
                                    <i class="bi bi-grid-3x3-gap"></i>

                                {% elif category.name|lower in ['tv units', 'tv & entertainment'] %}
                                    <i class="bi bi-tv"></i>

                                {% elif category.name|lower in ['wardrobes'] %}
                                    <i class="bi bi-door-open"></i>

                                {% elif category.name|lower in ['office furniture'] %}
                                    <i class="bi bi-briefcase"></i>

                                {% else %}
                                    <i class="bi bi-house"></i>
                                {% endif %}

                            </span>

                            <span>
                                <strong>{{ category.name }}</strong>
                                <small>Explore collection</small>
                            </span>

                        </a>

                        {% set quick_items = quick_items + [category] %}

                    {% endif %}

                {% endfor %}

            </div>

        </div>

    </section>


    <!-- =====================================================
         SHOWROOM / DEPARTMENTS
    ====================================================== -->

    <section class="ef-section ef-showroom">

        <div class="ef-container">

            <div class="ef-section-head">

                <div>
                    <span class="ef-eyebrow">Our Showroom</span>

                    <h2>
                        Explore Furniture
                    </h2>

                    <p>
                        Browse by department, choose a specific design,
                        then explore the complete collection. Every product
                        is connected to its exact category and collection.
                    </p>
                </div>

            </div>


            {% for category in categories %}

                {% if category.home_subcategories %}

                    <div class="ef-department">

                        <!-- Department heading -->

                        <div class="ef-department-head">

                            <div>

                                <span class="ef-eyebrow">
                                    {{ loop.index }} · Department
                                </span>

                                <h3>
                                    {{ category.name }}
                                </h3>

                                {% if category.description %}
                                    <p>
                                        {{ category.description }}
                                    </p>
                                {% else %}
                                    <p>
                                        Explore our {{ category.name|lower }}
                                        collection.
                                    </p>
                                {% endif %}

                            </div>

                        </div>


                        <!-- Subcategory selectors -->

                        <div class="ef-subcategories">

                            {% for subcategory in category.home_subcategories %}

                                <a href="{{ url_for('main.collection', slug=subcategory.slug) }}"
                                   class="ef-subcategory">

                                    {% if subcategory.image %}

                                        <img src="{{ url_for('static', filename=subcategory.image) }}"
                                             alt="{{ subcategory.name }} - {{ category.name }} at Eagle Furniture Ngara"
                                             loading="lazy">

                                    {% else %}

                                        <div style="
                                            width:100%;
                                            height:100%;
                                            min-height:150px;
                                            background:#d8cec5;
                                        "></div>

                                    {% endif %}

                                    <div class="ef-subcategory-content">

                                        <strong>
                                            {{ subcategory.name }}
                                        </strong>

                                        <small>
                                            {% if subcategory.products %}
                                                {{ subcategory.products|selectattr('active')|list|length }}
                                                designs
                                            {% else %}
                                                Explore designs
                                            {% endif %}
                                        </small>

                                    </div>

                                </a>

                            {% endfor %}

                        </div>


                        <!-- Products belonging to this department -->

                        {% set department_products = [] %}

                        {% for subcategory in category.home_subcategories %}

                            {% for product in subcategory.products %}

                                {% if product.active and product.image %}

                                    {% set department_products =
                                        department_products + [product] %}

                                {% endif %}

                            {% endfor %}

                        {% endfor %}


                        {% if department_products %}

                            <div class="ef-products">

                                {% for product in department_products[:8] %}

                                    <article class="ef-product">

                                        <a href="{{ url_for('main.product', product_id=product.id) }}"
                                           class="ef-product-media">

                                            {% if product.sale_price and product.price and product.sale_price < product.price %}

                                                <span class="ef-badge">
                                                    Sale
                                                </span>

                                            {% elif product.best_seller %}

                                                <span class="ef-badge">
                                                    Best Seller
                                                </span>

                                            {% elif product.new_arrival %}

                                                <span class="ef-badge">
                                                    New
                                                </span>

                                            {% endif %}

                                            <img src="{{ url_for('static', filename=product.image) }}"
                                                 alt="{{ product.name }} - Eagle Furniture Ngara"
                                                 loading="lazy">

                                        </a>


                                        <div class="ef-product-body">

                                            <span class="ef-product-category">
                                                {{ category.name }}
                                            </span>

                                            <h3 class="ef-product-name">

                                                <a href="{{ url_for('main.product', product_id=product.id) }}">
                                                    {{ product.name }}
                                                </a>

                                            </h3>


                                            <div class="ef-product-price">

                                                {% if product.sale_price and product.price and product.sale_price < product.price %}

                                                    <span class="ef-price-current">
                                                        KSh {{ "{:,.0f}".format(product.sale_price) }}
                                                    </span>

                                                    <span class="ef-price-old">
                                                        KSh {{ "{:,.0f}".format(product.price) }}
                                                    </span>

                                                {% elif product.price %}

                                                    <span class="ef-price-current">
                                                        KSh {{ "{:,.0f}".format(product.price) }}
                                                    </span>

                                                {% else %}

                                                    <span class="ef-price-current">
                                                        Price on Request
                                                    </span>

                                                {% endif %}

                                            </div>


                                            {% if product.description %}

                                                <p class="ef-product-description">
                                                    {{ product.description|striptags|truncate(90, True, '...') }}
                                                </p>

                                            {% else %}

                                                <p class="ef-product-description">
                                                    Quality {{ product.name|lower }}
                                                    made to order by Eagle Furniture.
                                                </p>

                                            {% endif %}


                                            <div class="ef-product-action">

                                                <a href="{{ url_for('main.product', product_id=product.id) }}"
                                                   class="ef-view-product">
                                                    View Product
                                                </a>

                                                <a href="https://wa.me/254717369779?text={{ ('Hello Eagle Furniture, I am interested in ' ~ product.name ~ '. Please share more details and availability.')|urlencode }}"
                                                   class="ef-whatsapp"
                                                   target="_blank"
                                                   rel="noopener"
                                                   aria-label="Ask about {{ product.name }} on WhatsApp">
                                                    <i class="bi bi-whatsapp"></i>
                                                    Enquire
                                                </a>

                                            </div>

                                        </div>

                                    </article>

                                {% endfor %}

                            </div>


                            <!-- Collection link -->

                            {% if category.home_subcategories|length > 0 %}

                                <div class="ef-collection-footer">

                                    <a href="{{ url_for('main.collection', slug=category.home_subcategories[0].slug) }}"
                                       class="ef-collection-button">

                                        Explore {{ category.name }}
                                        <i class="bi bi-arrow-right"></i>

                                    </a>

                                </div>

                            {% endif %}

                        {% else %}

                            <div class="ef-empty">
                                More {{ category.name|lower }} designs are being prepared.
                            </div>

                        {% endif %}

                    </div>

                {% endif %}

            {% else %}

                <div class="ef-empty">
                    Our furniture collections are being updated.
                </div>

            {% endfor %}

        </div>

    </section>


    <!-- =====================================================
         SPECIAL OFFERS
    ====================================================== -->

    {% if offers %}

        <section class="ef-section ef-offers">

            <div class="ef-container">

                <div class="ef-section-head">

                    <div>

                        <span class="ef-eyebrow">
                            Limited Offers
                        </span>

                        <h2>
                            Special Furniture Offers
                        </h2>

                        <p>
                            Discover selected furniture currently available
                            at special prices.
                        </p>

                    </div>

                </div>


                <div class="ef-products">

                    {% for product in offers[:8] %}

                        <article class="ef-product">

                            <a href="{{ url_for('main.product', product_id=product.id) }}"
                               class="ef-product-media">

                                <span class="ef-badge ef-offer-badge">
                                    Offer
                                </span>

                                <img src="{{ url_for('static', filename=product.image) }}"
                                     alt="{{ product.name }} offer - Eagle Furniture"
                                     loading="lazy">

                            </a>


                            <div class="ef-product-body">

                                <span class="ef-product-category">
                                    {{ product.category.name if product.category else 'Furniture' }}
                                </span>

                                <h3 class="ef-product-name">
                                    <a href="{{ url_for('main.product', product_id=product.id) }}">
                                        {{ product.name }}
                                    </a>
                                </h3>


                                <div class="ef-product-price">

                                    <span class="ef-price-current">
                                        KSh {{ "{:,.0f}".format(product.sale_price) }}
                                    </span>

                                    <span class="ef-price-old">
                                        KSh {{ "{:,.0f}".format(product.price) }}
                                    </span>

                                </div>


                                <div class="ef-product-action">

                                    <a href="{{ url_for('main.product', product_id=product.id) }}"
                                       class="ef-view-product">
                                        View Product
                                    </a>

                                    <a href="https://wa.me/254717369779?text={{ ('Hello Eagle Furniture, I am interested in the offer on ' ~ product.name ~ '.')|urlencode }}"
                                       class="ef-whatsapp"
                                       target="_blank"
                                       rel="noopener">
                                        <i class="bi bi-whatsapp"></i>
                                        Enquire
                                    </a>

                                </div>

                            </div>

                        </article>

                    {% endfor %}

                </div>

            </div>

        </section>

    {% endif %}


    <!-- =====================================================
         BEST SELLERS
    ====================================================== -->

    {% if best_sellers %}

        <section class="ef-section">

            <div class="ef-container">

                <div class="ef-section-head">

                    <div>

                        <span class="ef-eyebrow">
                            Customer Favourites
                        </span>

                        <h2>
                            Best Sellers
                        </h2>

                        <p>
                            Explore some of the furniture designs our
                            customers choose most often.
                        </p>

                    </div>

                </div>


                <div class="ef-products">

                    {% for product in best_sellers[:8] %}

                        <article class="ef-product">

                            <a href="{{ url_for('main.product', product_id=product.id) }}"
                               class="ef-product-media">

                                <span class="ef-badge">
                                    Best Seller
                                </span>

                                <img src="{{ url_for('static', filename=product.image) }}"
                                     alt="{{ product.name }} - Best Seller Eagle Furniture"
                                     loading="lazy">

                            </a>


                            <div class="ef-product-body">

                                <span class="ef-product-category">
                                    {{ product.category.name if product.category else 'Furniture' }}
                                </span>

                                <h3 class="ef-product-name">
                                    <a href="{{ url_for('main.product', product_id=product.id) }}">
                                        {{ product.name }}
                                    </a>
                                </h3>


                                <div class="ef-product-price">

                                    {% if product.sale_price and product.price and product.sale_price < product.price %}

                                        <span class="ef-price-current">
                                            KSh {{ "{:,.0f}".format(product.sale_price) }}
                                        </span>

                                        <span class="ef-price-old">
                                            KSh {{ "{:,.0f}".format(product.price) }}
                                        </span>

                                    {% elif product.price %}

                                        <span class="ef-price-current">
                                            KSh {{ "{:,.0f}".format(product.price) }}
                                        </span>

                                    {% else %}

                                        <span class="ef-price-current">
                                            Price on Request
                                        </span>

                                    {% endif %}

                                </div>


                                <div class="ef-product-action">

                                    <a href="{{ url_for('main.product', product_id=product.id) }}"
                                       class="ef-view-product">
                                        View Product
                                    </a>

                                    <a href="https://wa.me/254717369779?text={{ ('Hello Eagle Furniture, I am interested in ' ~ product.name ~ '.')|urlencode }}"
                                       class="ef-whatsapp"
                                       target="_blank"
                                       rel="noopener">
                                        <i class="bi bi-whatsapp"></i>
                                        Enquire
                                    </a>

                                </div>

                            </div>

                        </article>

                    {% endfor %}

                </div>

            </div>

        </section>

    {% endif %}


    <!-- =====================================================
         NEW ARRIVALS
    ====================================================== -->

    {% if new_arrivals %}

        <section class="ef-section" style="background:#faf8f5;">

            <div class="ef-container">

                <div class="ef-section-head">

                    <div>

                        <span class="ef-eyebrow">
                            Fresh Designs
                        </span>

                        <h2>
                            New Arrivals
                        </h2>

                        <p>
                            Discover the latest furniture designs added
                            to the Eagle Furniture collection.
                        </p>

                    </div>

                </div>


                <div class="ef-products">

                    {% for product in new_arrivals[:8] %}

                        <article class="ef-product">

                            <a href="{{ url_for('main.product', product_id=product.id) }}"
                               class="ef-product-media">

                                <span class="ef-badge">
                                    New Arrival
                                </span>

                                <img src="{{ url_for('static', filename=product.image) }}"
                                     alt="{{ product.name }} - New Arrival Eagle Furniture"
                                     loading="lazy">

                            </a>


                            <div class="ef-product-body">

                                <span class="ef-product-category">
                                    {{ product.category.name if product.category else 'Furniture' }}
                                </span>

                                <h3 class="ef-product-name">
                                    <a href="{{ url_for('main.product', product_id=product.id) }}">
                                        {{ product.name }}
                                    </a>
                                </h3>


                                <div class="ef-product-price">

                                    {% if product.sale_price and product.price and product.sale_price < product.price %}

                                        <span class="ef-price-current">
                                            KSh {{ "{:,.0f}".format(product.sale_price) }}
                                        </span>

                                        <span class="ef-price-old">
                                            KSh {{ "{:,.0f}".format(product.price) }}
                                        </span>

                                    {% elif product.price %}

                                        <span class="ef-price-current">
                                            KSh {{ "{:,.0f}".format(product.price) }}
                                        </span>

                                    {% else %}

                                        <span class="ef-price-current">
                                            Price on Request
                                        </span>

                                    {% endif %}

                                </div>


                                <div class="ef-product-action">

                                    <a href="{{ url_for('main.product', product_id=product.id) }}"
                                       class="ef-view-product">
                                        View Product
                                    </a>

                                    <a href="https://wa.me/254717369779?text={{ ('Hello Eagle Furniture, I am interested in ' ~ product.name ~ '.')|urlencode }}"
                                       class="ef-whatsapp"
                                       target="_blank"
                                       rel="noopener">
                                        <i class="bi bi-whatsapp"></i>
                                        Enquire
                                    </a>

                                </div>

                            </div>

                        </article>

                    {% endfor %}

                </div>

            </div>

        </section>

    {% endif %}


    <!-- =====================================================
         FEATURED FURNITURE
    ====================================================== -->

    {% if featured_products %}

        <section class="ef-section">

            <div class="ef-container">

                <div class="ef-section-head">

                    <div>

                        <span class="ef-eyebrow">
                            Eagle Selection
                        </span>

                        <h2>
                            Featured Furniture
                        </h2>

                        <p>
                            A selection of furniture designs we are proud
                            to showcase.
                        </p>

                    </div>

                </div>


                <div class="ef-products">

                    {% for product in featured_products[:8] %}

                        <article class="ef-product">

                            <a href="{{ url_for('main.product', product_id=product.id) }}"
                               class="ef-product-media">

                                <img src="{{ url_for('static', filename=product.image) }}"
                                     alt="{{ product.name }} - Featured furniture at Eagle Furniture Ngara"
                                     loading="lazy">

                            </a>


                            <div class="ef-product-body">

                                <span class="ef-product-category">
                                    {{ product.category.name if product.category else 'Furniture' }}
                                </span>

                                <h3 class="ef-product-name">
                                    <a href="{{ url_for('main.product', product_id=product.id) }}">
                                        {{ product.name }}
                                    </a>
                                </h3>


                                <div class="ef-product-price">

                                    {% if product.sale_price and product.price and product.sale_price < product.price %}

                                        <span class="ef-price-current">
                                            KSh {{ "{:,.0f}".format(product.sale_price) }}
                                        </span>

                                        <span class="ef-price-old">
                                            KSh {{ "{:,.0f}".format(product.price) }}
                                        </span>

                                    {% elif product.price %}

                                        <span class="ef-price-current">
                                            KSh {{ "{:,.0f}".format(product.price) }}
                                        </span>

                                    {% else %}

                                        <span class="ef-price-current">
                                            Price on Request
                                        </span>

                                    {% endif %}

                                </div>


                                <div class="ef-product-action">

                                    <a href="{{ url_for('main.product', product_id=product.id) }}"
                                       class="ef-view-product">
                                        View Product
                                    </a>

                                    <a href="https://wa.me/254717369779?text={{ ('Hello Eagle Furniture, I am interested in ' ~ product.name ~ '.')|urlencode }}"
                                       class="ef-whatsapp"
                                       target="_blank"
                                       rel="noopener">
                                        <i class="bi bi-whatsapp"></i>
                                        Enquire
                                    </a>

                                </div>

                            </div>

                        </article>

                    {% endfor %}

                </div>

            </div>

        </section>

    {% endif %}


    <!-- =====================================================
         CUSTOM FURNITURE
    ====================================================== -->

    <section class="ef-section ef-custom">

        <div class="ef-container">

            <div class="ef-custom-grid">

                <div class="ef-custom-image"></div>

                <div class="ef-custom-content">

                    <span class="ef-eyebrow">
                        Made For You
                    </span>

                    <h2>
                        Your Furniture.
                        Your Design.
                    </h2>

                    <p>
                        Eagle Furniture specialises in made-to-order
                        furniture. Choose your preferred design, fabric,
                        colour, dimensions and finish, and we create
                        furniture designed around your space.
                    </p>


                    <div class="ef-benefits">

                        <div class="ef-benefit">
                            <i class="bi bi-check-circle-fill"></i>
                            Bespoke designs
                        </div>

                        <div class="ef-benefit">
                            <i class="bi bi-check-circle-fill"></i>
                            Custom colours
                        </div>

                        <div class="ef-benefit">
                            <i class="bi bi-check-circle-fill"></i>
                            Custom dimensions
                        </div>

                        <div class="ef-benefit">
                            <i class="bi bi-check-circle-fill"></i>
                            Quality materials
                        </div>

                    </div>


                    <div>

                        <a href="https://wa.me/254717369779?text=Hello%20Eagle%20Furniture%2C%20I%20would%20like%20to%20discuss%20a%20custom%20furniture%20design."
                           class="ef-btn ef-btn-primary"
                           target="_blank"
                           rel="noopener">

                            Discuss Your Design
                            <i class="bi bi-whatsapp"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         PACKAGES
    ====================================================== -->

    {% if featured_bundles %}

        <section class="ef-section">

            <div class="ef-container">

                <div class="ef-section-head">

                    <div>

                        <span class="ef-eyebrow">
                            Complete Your Space
                        </span>

                        <h2>
                            Furniture Packages
                        </h2>

                        <p>
                            Build your space with coordinated furniture
                            packages designed for convenience and value.
                        </p>

                    </div>

                </div>


                <div class="ef-packages">

                    {% for bundle in featured_bundles[:6] %}

                        <article class="ef-package">

                            <h3>
                                {{ bundle.name }}
                            </h3>

                            {% if bundle.description %}

                                <p>
                                    {{ bundle.description }}
                                </p>

                            {% endif %}

                            <a href="{{ url_for('main.bundle', bundle_id=bundle.id) }}">

                                Explore Package
                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </article>

                    {% endfor %}

                </div>

            </div>

        </section>

    {% endif %}


    <!-- =====================================================
         ORDER / DELIVERY INFORMATION
    ====================================================== -->

    <section class="ef-section" style="background:#fff;">

        <div class="ef-container">

            <div class="ef-section-head">

                <div>

                    <span class="ef-eyebrow">
                        Simple & Transparent
                    </span>

                    <h2>
                        From Your Idea To Your Home
                    </h2>

                    <p>
                        We make ordering your furniture simple. Agree on
                        the design, colour and price, secure your production
                        slot and we take care of the rest.
                    </p>

                </div>

            </div>


            <div class="ef-packages">

                <article class="ef-package">

                    <span class="ef-eyebrow">
                        01
                    </span>

                    <h3>
                        Choose Your Design
                    </h3>

                    <p>
                        Browse our collections or share your preferred
                        design with our team.
                    </p>

                </article>


                <article class="ef-package">

                    <span class="ef-eyebrow">
                        02
                    </span>

                    <h3>
                        Confirm Your Order
                    </h3>

                    <p>
                        Once the design, colour and price are agreed,
                        a 60% deposit secures your production and
                        delivery date.
                    </p>

                </article>


                <article class="ef-package">

                    <span class="ef-eyebrow">
                        03
                    </span>

                    <h3>
                        We Deliver
                    </h3>

                    <p>
                        We complete your furniture and arrange delivery.
                        Delivery is free within Nairobi; outside Nairobi,
                        the customer assists with transport costs.
                    </p>

                </article>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FINAL CTA
    ====================================================== -->

    <section class="ef-final-cta">

        <div class="ef-container">

            <span class="ef-eyebrow">
                Eagle Furniture Ngara
            </span>

            <h2>
                Let's Create Your Perfect Space.
            </h2>

            <p>
                Visit our workshop on Murang'a Road, Ngara, next to
                Kahama Hotel, or speak to us directly on WhatsApp.
            </p>


            <div class="ef-final-actions">

                <a href="https://wa.me/254717369779"
                   class="ef-btn ef-btn-primary"
                   target="_blank"
                   rel="noopener">

                    <i class="bi bi-whatsapp"></i>
                    WhatsApp 0717 369 779

                </a>


                <a href="tel:+254717369779"
                   class="ef-btn ef-btn-light">

                    <i class="bi bi-telephone"></i>
                    Call Us

                </a>

            </div>

        </div>

    </section>

</div>

{% endblock %}